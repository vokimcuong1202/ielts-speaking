                "custom"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"term\": \"tend to\",\n  \"meaningVi\": \"có xu hướng\",\n  \"sourceQuestionId\": \"{{questionId}}\"\n}"
            },
            "description": "Adds (or reuses) the phrase in the catalogue and puts it in my notebook with source `manual`. Response `id` is the userVocabId."
          }
        },
        {
          "name": "AI hỗ trợ – pronunciation check",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pronunciation-checks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pronunciation-checks"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "text",
                  "type": "text",
                  "value": "stand out from the crowd"
                }
              ]
            },
            "description": "Multipart: `file` (recording, ≤5MB, not stored) + `text` (what the learner tried to say). Returns score 0–100 and per-word status. Scoring is a mock until a real provider is wired in."
          }
        }
